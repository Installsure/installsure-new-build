# Database
DATABASE_URL=postgresql://installsure:password@localhost:5432/installsure

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Authentication
AUTH_SECRET=super-secure-secret-key-for-installsure-at-least-32-chars

# File uploads (general)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Plans upload configuration
PLANS_MAX_FILE_SIZE=524288000
PLANS_UPLOAD_DIR=./uploads/plans
PLANS_RETRY_MAX_ATTEMPTS=3
PLANS_RETRY_BASE_DELAY_MS=500

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@installsure.com

# Environment
NODE_ENV=development
PORT=8080

# Logging
LOG_LEVEL=info

# Storage (leave blank to use local storage)
S3_ENDPOINT=
S3_BUCKET=
FILES_LOCAL_DIR=./uploads

# Forge/AutoCAD (optional)
FORGE_CLIENT_ID=
FORGE_CLIENT_SECRET=
FORGE_BUCKET=

# Sentry (optional)
SENTRY_DSN=
FEATURE_SENTRY=false

# QuickBooks (optional)
QB_CLIENT_ID=
QB_CLIENT_SECRET=
FEATURE_QB=false
