// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  avatar    String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedProjects    Project[]       @relation("ProjectOwner")
  projectMembers   ProjectMember[]
  submittedRfis    Rfi[]           @relation("RfiSubmitter")
  assignedRfis     Rfi[]           @relation("RfiAssignee")
  rfiResponses     RfiResponse[]
  createdTasks     Task[]          @relation("TaskCreator")
  assignedTasks    Task[]          @relation("TaskAssignee")
  createdTags      Tag[]
  comments         Comment[]
  changeOrders     ChangeOrder[]
  files            File[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String

  // Relations
  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members      ProjectMember[]
  planFiles    PlanFile[]
  rfis         Rfi[]
  tasks        Task[]
  tags         Tag[]
  changeOrders ChangeOrder[]
  events       Event[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  // Relations
  project User @relation(fields: [projectId], references: [id])
  user    Project @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
}

model PlanFile {
  id            String   @id @default(cuid())
  projectId     String?
  uploadedById  String?
  name          String
  type          FileType
  path          String
  checksum      String   @unique
  size          Int
  mimeType      String
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  project  Project? @relation(fields: [projectId], references: [id])
  tags     Tag[]

  @@index([checksum])
  @@index([projectId])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("plan_files")
}

model Rfi {
  id            String     @id @default(cuid())
  projectId     String
  number        String
  title         String
  description   String
  status        RfiStatus  @default(OPEN)
  priority      Priority   @default(MEDIUM)
  submittedById String
  assignedToId  String?
  dueDate       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  project      Project       @relation(fields: [projectId], references: [id])
  submittedBy  User          @relation("RfiSubmitter", fields: [submittedById], references: [id])
  assignedTo   User?         @relation("RfiAssignee", fields: [assignedToId], references: [id])
  responses    RfiResponse[]
  attachments  File[]        @relation("RfiAttachments")

  @@unique([projectId, number])
  @@map("rfis")
}

model RfiResponse {
  id        String   @id @default(cuid())
  rfiId     String
  userId    String
  content   String
  createdAt DateTime @default(now())

  // Relations
  rfi  Rfi  @relation(fields: [rfiId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("rfi_responses")
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  createdById String
  assigneeId  String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  project     Project @relation(fields: [projectId], references: [id])
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id])
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  attachments File[]  @relation("TaskAttachments")
  linkedTags  Tag[]   @relation("TaskTags")

  @@map("tasks")
}

model Tag {
  id         String    @id @default(cuid())
  projectId  String
  planFileId String?
  type       TagType
  title      String
  content    String?
  status     TagStatus @default(OPEN)
  x          Float
  y          Float
  z          Float?
  color      String    @default("#FF0000")
  createdById String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  project     Project   @relation(fields: [projectId], references: [id])
  planFile    PlanFile? @relation(fields: [planFileId], references: [id])
  createdBy   User      @relation(fields: [createdById], references: [id])
  comments    Comment[]
  attachments File[]    @relation("TagAttachments")
  linkedTasks Task[]    @relation("TaskTags")

  @@map("tags")
}

model Comment {
  id        String   @id @default(cuid())
  tagId     String
  userId    String
  content   String
  mentions  String[] // Array of user IDs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tag  Tag  @relation(fields: [tagId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("comments")
}

model ChangeOrder {
  id          String            @id @default(cuid())
  projectId   String
  number      String
  title       String
  description String
  status      ChangeOrderStatus @default(DRAFT)
  amount      Decimal?
  reason      String?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  project   Project        @relation(fields: [projectId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  lineItems ChangeOrderLineItem[]

  @@unique([projectId, number])
  @@map("change_orders")
}

model ChangeOrderLineItem {
  id            String  @id @default(cuid())
  changeOrderId String
  description   String
  quantity      Decimal
  unitPrice     Decimal
  totalPrice    Decimal

  // Relations
  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id])

  @@map("change_order_line_items")
}

model Event {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  color       String    @default("#3B82F6")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id])

  @@map("events")
}

model File {
  id         String   @id @default(cuid())
  name       String
  path       String
  size       Int
  mimeType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [uploadedBy], references: [id])

  // File can be attached to various entities
  rfiAttachments  Rfi[]  @relation("RfiAttachments")
  taskAttachments Task[] @relation("TaskAttachments")
  tagAttachments  Tag[]  @relation("TagAttachments")

  @@map("files")
}

// Enums
enum Role {
  ADMIN
  MANAGER
  USER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum FileType {
  IFC
  PDF
  IMAGE
  DOCUMENT
}

enum RfiStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TagType {
  ISSUE
  NOTE
  MEASUREMENT
  PHOTO
  DEFECT
}

enum TagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChangeOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IMPLEMENTED
}