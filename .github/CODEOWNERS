/backend/src/routes/auth.ts     @tier2-implementation @tier3-quality
/backend/src/services/auth.ts   @tier2-implementation @tier3-quality
/frontend/src/contexts/AuthContext.tsx @tier2-implementation @tier3-quality

# Project Management
/backend/src/routes/projects.ts @tier2-implementation
/backend/src/services/projects.ts @tier2-implementation
/frontend/src/pages/ProjectsPage.tsx @tier2-implementation

# RFI System
/backend/src/routes/rfis.ts     @tier2-implementation
/backend/src/services/rfis.ts   @tier2-implementation
/frontend/src/pages/RFIsPage.tsx @tier2-implementation

# BIM Processing
/bim/main.py                    @tier2-implementation @tier3-quality
/backend/src/routes/autocad.ts  @tier2-implementation

# ============================================================================
# Default Ownership
# ============================================================================

