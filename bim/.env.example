# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
APP_VERSION=2.0.0

# Environment
PYTHON_ENV=development

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# LLM Configuration
LLM_ENABLED=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Forge/AutoCAD Integration
FORGE_CLIENT_ID=your-forge-client-id
FORGE_CLIENT_SECRET=your-forge-client-secret
FORGE_BASE_URL=https://developer.api.autodesk.com
FORGE_BUCKET=installsure-dev

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=installsure-files

# Features
ENABLE_REAL_TIME_SYNC=true
ENABLE_FILE_PROCESSING=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Logging
LOG_LEVEL=info
LOG_DIR=./logs